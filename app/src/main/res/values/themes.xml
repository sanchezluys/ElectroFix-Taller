<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyApplication" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Ensures content extends into cutout areas across all devices (Android 9+) -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <!-- Ensures window draws system bar backgrounds across all API levels -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
